// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  VILLAGE_ADMIN  @map("village_admin") // สำหรับผู้ดูแลหมู่บ้าน
  METER_READER   @map("meter_reader") // สำหรับผู้อ่านมิเตอร์
  RESIDENT       @map("resident") // สำหรับลูกบ้าน
}

enum UserVillageStatus {
  ACTIVE         @map("active") // สถานะใช้งาน
  SUSPENDED      @map("suspended") // สถานะหยุดใช้งาน
}

enum PropertyStatus {
  ACTIVE         @map("active") // สถานะใช้งาน
  SUSPENDED      @map("suspended") // สถานะหยุดใช้งาน
}

enum InvoiceStatus {
  PENDING        @map("pending") // สถานะรอการตรวจสอบ
  VERIFYING      @map("verifying") // สถานะกำลังตรวจสอบ
  PAID_CASH      @map("paid_cash") // สถานะชำระเงินสด
  PAID_ONLINE    @map("paid_online") // สถานะชำระเงินออนไลน์
  OVERDUE        @map("overdue") // สถานะเกินกำหนด
}

enum PaymentSlipStatus {
  SUBMITTED      @map("submitted") // สถานะส่งใบเสร็จ
  APPROVED       @map("approved") // สถานะอนุมัติ
  REJECTED       @map("rejected") // สถานะไม่อนุมัติ
}

// ==========================================
// MODELS
// ==========================================

/// 1. ข้อมูลหมู่บ้าน (Tenants)
model Village {
  id                Int      @id @default(autoincrement()) @map("village_id")
  villageCode       String   @unique @map("village_code") @db.VarChar(20) // รหัสหมู่บ้าน เช่น V001
  address           String?  @db.Text // ที่อยู่ เช่น บ้านคลองไคร หมู่ที่ 10
  subDistrict       String?  @db.VarChar(100) // ตำบล
  district          String?  @db.VarChar(100) // อำเภอ
  province          String?  @db.VarChar(100) // จังหวัด
  postalCode        String?  @db.VarChar(10) // รหัสไปรษณีย์
  defaultServiceFee Decimal  @default(0.00) @map("default_service_fee") @db.Decimal(8, 2) // ค่าบริการเริ่มต้น
  promptpayNo       String?  @map("promptpay_no") @db.VarChar(20) // เลขบัญชี PromptPay
  promptpayName     String?  @map("promptpay_name") @db.VarChar(100) // ชื่อ PromptPay
  promptpayImage    String?  @map("promptpay_image") @db.VarChar(255) // รูปภาพ PromptPay

  // Feature Flag: เปิด-ปิด ระบบโอนเงิน PromptPay ( default: false จ่ายเงินสดก่อน )
  enablePromptpay   Boolean  @default(false) @map("enable_promptpay")

  isActive          Boolean  @default(true) @map("is_active") // สถานะเปิด-ปิด
  createdAt         DateTime @default(now()) @map("created_at") // วันที่สร้าง
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") // วันที่อัปเดต

  // Relations
  userVillages  UserVillage[]
  waterRates    WaterRate[]
  properties    Property[]
  meterReadings MeterReading[]
  invoices      Invoice[]
  auditLogs     AuditLog[]

  @@map("villages")
}

/// 2. ข้อมูลผู้ใช้งานกลาง
model User {
  id            Int      @id @default(autoincrement()) @map("user_id")
  lineUserId    String   @unique @map("line_user_id") @db.VarChar(255) // เลขผู้ใช้ LINE
  fullName      String   @map("full_name") @db.VarChar(100) // ชื่อ-นามสกุล
  phoneNumber   String?  @map("phone_number") @db.VarChar(15) // เบอร์โทร
  isGlobalAdmin Boolean  @default(false) @map("is_global_admin") // สถานะผู้ดูแลระบบ
  createdAt     DateTime @default(now()) @map("created_at") // วันที่สร้าง
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") // วันที่อัปเดต

  // Relations
  userVillages     UserVillage[]
  userProperties   UserProperty[]
  readingsTaken    MeterReading[] @relation("ReaderReadings")
  paymentsMade     Payment[]      @relation("PaidBy")
  paymentsVerified Payment[]      @relation("VerifiedBy")
  auditLogs        AuditLog[]

  @@map("users")
}

/// 3. ตารางผูกสิทธิ์ผู้ใช้กับหมู่บ้าน
model UserVillage {
  id        Int               @id @default(autoincrement()) @map("user_village_id")
  userId    Int               @map("user_id") // รหัสผู้ใช้
  villageId Int               @map("village_id") // รหัสหมู่บ้าน
  role      Role              @default(RESIDENT) // สิทธิ์ผู้ใช้
  status    UserVillageStatus @default(ACTIVE) // สถานะ
  createdAt DateTime          @default(now()) @map("created_at") // วันที่สร้าง

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  village Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([userId, villageId])
  @@index([villageId])
  @@map("user_villages")
}

/// 4. ตารางอัตราค่าน้ำแบบก้าวหน้า (Tiered Water Rate)
model WaterRate {
  id           Int      @id @default(autoincrement()) @map("rate_id")
  villageId    Int      @map("village_id") // รหัสหมู่บ้าน
  minUnit      Decimal  @default(0.00) @map("min_unit") @db.Decimal(10, 2) // จำนวนหน่วยน้ำต่ำสุด
  maxUnit      Decimal? @map("max_unit") @db.Decimal(10, 2) // จำนวนหน่วยน้ำสูงสุด
  pricePerUnit Decimal  @map("price_per_unit") @db.Decimal(8, 2) // ราคาต่อหน่วย
  createdAt    DateTime @default(now()) @map("created_at") // วันที่สร้าง

  village Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@index([villageId])
  @@map("water_rates")
}

/// 5. ตารางแปลง/บ้านเลขที่
model Property {
  id          Int            @id @default(autoincrement()) @map("property_id")
  villageId   Int            @map("village_id") // รหัสหมู่บ้าน
  houseNumber String         @map("house_number") @db.VarChar(50) // เลขบ้าน
  zone        String?        @db.VarChar(50) // หน่วย
  meterCode   String?        @map("meter_code") @db.VarChar(50) // รหัสตัววัด
  status      PropertyStatus @default(ACTIVE) // สถานะ
  createdAt   DateTime       @default(now()) @map("created_at") // วันที่สร้าง
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") // วันที่อัปเดต

  village        Village        @relation(fields: [villageId], references: [id], onDelete: Cascade)
  userProperties UserProperty[]
  meterReadings  MeterReading[]
  invoices       Invoice[]

  @@unique([villageId, houseNumber])
  @@index([villageId])
  @@map("properties")
}

/// 6. ตารางผูกสิทธิ์คนเข้ากับบ้าน
model UserProperty {
  id             Int      @id @default(autoincrement()) @map("user_property_id")
  userId         Int      @map("user_id") // รหัสผู้ใช้
  propertyId     Int      @map("property_id") // รหัสบ้าน
  createdAt      DateTime @default(now()) @map("created_at") // วันที่สร้าง
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") // วันที่อัปเดต

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@index([userId])
  @@map("user_properties")
}

/// 7. ตารางบันทึกการอ่านมิเตอร์น้ำ
model MeterReading {
  id              Int      @id @default(autoincrement()) @map("reading_id")
  villageId       Int      @map("village_id") // รหัสหมู่บ้าน
  propertyId      Int      @map("property_id") // รหัสบ้าน
  readerId        Int?     @map("reader_id") // รหัสผู้อ่าน
  billingMonth    DateTime @map("billing_month") @db.Date // เดือนบิล
  previousReading Decimal  @map("previous_reading") @db.Decimal(10, 2) // อ่านมิเตอร์ก่อนหน้า
  currentReading  Decimal  @map("current_reading") @db.Decimal(10, 2) // อ่านมิเตอร์ปัจจุบัน
  consumption     Decimal  @map("consumption") @db.Decimal(10, 2) // ยอดรวม
  imageUrl        String?  @map("image_url") @db.Text // URL รูปภาพ
  readingDate     DateTime @default(now()) @map("reading_date") // วันที่อ่าน

  village  Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reader   User?    @relation("ReaderReadings", fields: [readerId], references: [id], onDelete: SetNull)
  invoice  Invoice?

  @@unique([propertyId, billingMonth])
  @@index([villageId, billingMonth])
  @@index([propertyId])
  @@map("meter_readings")
}

/// 8. ตารางใบแจ้งหนี้ / บิล
model Invoice {
  id            Int           @id @default(autoincrement()) @map("invoice_id")
  villageId     Int           @map("village_id") // รหัสหมู่บ้าน
  propertyId    Int           @map("property_id") // รหัสบ้าน
  readingId     Int           @unique @map("reading_id") // รหัสอ่านมิเตอร์
  billingMonth  DateTime      @map("billing_month") @db.Date // เดือนบิล
  waterAmount   Decimal       @map("water_amount") @db.Decimal(10, 2) // ยอดน้ำ
  serviceFee    Decimal       @default(0.00) @map("service_fee") @db.Decimal(10, 2) // ค่าบริการ
  fineAmount    Decimal       @default(0.00) @map("fine_amount") @db.Decimal(10, 2) // ค่าปรับ
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2) // ยอดสุทธิ
  paymentStatus InvoiceStatus @default(PENDING) @map("payment_status") // สถานะการชำระ
  dueDate       DateTime      @map("due_date") @db.Date // วันที่ต้องชำระ
  createdAt     DateTime      @default(now()) @map("created_at") // วันที่สร้าง
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") // วันที่อัปเดต

  village  Village      @relation(fields: [villageId], references: [id], onDelete: Cascade)
  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reading  MeterReading @relation(fields: [readingId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([villageId, billingMonth])
  @@index([propertyId])
  @@index([paymentStatus])
  @@map("invoices")
}

/// 9. ตารางประวัติการชำระเงินสลิป
model Payment {
  id               Int               @id @default(autoincrement()) @map("payment_id")
  invoiceId        Int               @map("invoice_id") // รหัสใบแจ้งหนี้
  paidByUserId     Int?              @map("paid_by_user_id") // รหัสผู้ชำระ
  amountPaid       Decimal           @map("amount_paid") @db.Decimal(10, 2) // จำนวนเงินที่ชำระ
  slipUrl          String            @map("slip_url") @db.Text // URL สลิป
  verifiedByUserId Int?              @map("verified_by_user_id") // รหัสผู้ตรวจสอบ
  paymentStatus    PaymentSlipStatus @default(SUBMITTED) @map("payment_status") // สถานะการชำระ
  rejectReason     String?           @map("reject_reason") @db.Text // เหตุผลการปฏิเสธ
  verifiedAt       DateTime?         @map("verified_at") // วันที่ตรวจสอบ
  createdAt        DateTime          @default(now()) @map("created_at") // วันที่สร้าง

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paidBy     User?   @relation("PaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  verifiedBy User?   @relation("VerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("payments")
}

/// 10. ตารางบันทึกประวัติการแก้ไขข้อมูล (Audit Logs)
model AuditLog {
  id        Int      @id @default(autoincrement()) @map("log_id") // รหัสการแก้ไข
  villageId Int?     @map("village_id") // รหัสหมู่บ้าน
  userId    Int?     @map("user_id") // รหัสผู้ใช้
  action    String   @db.VarChar(50) // การกระทำ
  tableName String   @map("table_name") @db.VarChar(50) // ชื่อตาราง
  recordId  Int      @map("record_id") // รหัสรายการ
  oldData   Json?    @map("old_data") // ข้อมูลเดิม
  newData   Json?    @map("new_data") // ข้อมูลใหม่
  createdAt DateTime @default(now()) @map("created_at") // วันที่สร้าง

  village Village? @relation(fields: [villageId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([villageId])
  @@index([userId])
  @@map("audit_logs")
}
